# Merchant-local PostgreSQL database. Each merchant deployment uses its own database.
DATABASE_URL="postgresql://portal:change-me@localhost:5432/getedgeportal?schema=public"

# This deployment serves exactly one surface. HQ and merchant deployments never
# share cookies, user records, or merchant-local session data.
PORTAL_SURFACE="MERCHANT"

# Opaque Portal sessions; capability applications never receive this cookie.
PORTAL_SESSION_COOKIE_NAME="getedge_portal_session"
PORTAL_SESSION_TTL_HOURS="12"

# Move is independently deployed. Portal stores this trusted origin on the
# merchant entitlement and signs a short-lived handover ticket. The matching
# public key is configured in Move; the private key never leaves Portal.
MOVE_APPLICATION_ORIGIN="https://ops.getedge.uk"
MOVE_LAUNCH_TICKET_TTL_SECONDS="45"
MOVE_LAUNCH_KEY_ID="merchant-portal-move-1"
MOVE_LAUNCH_PRIVATE_KEY=""

# HQ authentication and merchant-local HQ support sessions use different cookies.
HQ_SESSION_COOKIE_NAME="getedge_hq_session"
HQ_SESSION_TTL_HOURS="8"
HQ_SUPPORT_SESSION_COOKIE_NAME="getedge_hq_support_session"
HQ_SUPPORT_SESSION_TTL_MINUTES="30"
HQ_ACCESS_TICKET_TTL_SECONDS="45"

# Set the private key only on HQ; set the matching public key only on merchants.
# Use an Ed25519 PKCS#8 private PEM and SPKI public PEM. Multiline values are
# supported by Vercel environment variables.
HQ_ACCESS_PRIVATE_KEY=""
HQ_ACCESS_PUBLIC_KEY=""

# Vercel sends this bearer secret to authenticated scheduled cleanup routes.
CRON_SECRET=""

# Base64-encoded 32-byte AES key used only to encrypt HQ TOTP secrets and the
# short-lived first-deployment MFA enrolment payload. Use a different key in
# staging and production.
HQ_MFA_ENCRYPTION_KEY=""

# Bootstrap values used only by `npm run prisma:seed` for a fresh merchant database.
# Sprint 1 does not create merchant users.
PORTAL_BOOTSTRAP_BUSINESS_ID="business_edge_demo"
PORTAL_BOOTSTRAP_BUSINESS_NAME="Edge Demo Business"
PORTAL_BOOTSTRAP_BUSINESS_SLUG="edge-demo"
PORTAL_CANONICAL_URL="https://merchant-temporary-url.vercel.app"

# Local/e2e-only deterministic store. The application rejects this mode in production.
PORTAL_DEMO_MODE="false"
