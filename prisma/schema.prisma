generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PortalRole {
  OWNER
  ADMIN
  MANAGER
  USER
}

enum PortalUserStatus {
  ACTIVE
  DISABLED
}

enum VatStatus {
  NOT_REGISTERED
  PENDING
  REGISTERED
}

enum MerchantApplicationStatus {
  NOT_INSTALLED
  INSTALLED
}

enum HQType {
  EDGE
  AFFILIATE
}

enum HQRole {
  ADMIN
  OPERATOR
}

enum HQAccessMode {
  SUPPORT_READ_ONLY
  EDGE_FULL_ACCESS
}

enum HQAccessAuditAction {
  TICKET_ISSUED
  SUPPORT_SESSION_CREATED
}

enum MerchantStatus {
  PROVISIONING
  READY
}

model Business {
  id                String                       @id @default(cuid())
  slug              String                       @unique
  name              String
  legalName         String?
  supportEmail      String?
  contactName       String?
  contactPhone      String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  county            String?
  postcode          String?
  countryCode       String                       @default("GB")
  vatStatus         VatStatus                    @default(NOT_REGISTERED)
  vatNumber         String?
  portalUrl         String?
  status            MerchantStatus               @default(PROVISIONING)
  timezone          String                       @default("Europe/London")
  currency          String                       @default("GBP")
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  memberships       BusinessMembership[]
  invitations       PortalUserInvitation[]
  applications      MerchantApplication[]
  capabilityAccess  PortalCapabilityAccess[]
  hqAssignments     HQBusinessAssignment[]
  hqSupportSessions HQSupportSession[]
  hqAccessAudits    HQAccessAuditEvent[]
  hqStatusAudits    HQMerchantStatusAuditEvent[]
  consumedTickets   HQAccessTicketNonce[]
}

model PortalUser {
  id               String                   @id @default(cuid())
  email            String                   @unique
  name             String
  passwordHash     String
  status           PortalUserStatus         @default(ACTIVE)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  memberships      BusinessMembership[]
  capabilityAccess PortalCapabilityAccess[]
}

model BusinessMembership {
  id               String                   @id @default(cuid())
  businessId       String
  userId           String
  role             PortalRole               @default(USER)
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  business         Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user             PortalUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions         PortalSession[]
  invitationsSent  PortalUserInvitation[]   @relation("InvitationSender")
  capabilityAccess PortalCapabilityAccess[]

  @@unique([businessId, userId])
  @@index([userId, isActive])
}

model PortalUserInvitation {
  id                    String             @id @default(cuid())
  businessId            String
  invitedByMembershipId String?
  name                  String
  email                 String
  role                  PortalRole         @default(USER)
  tokenHash             String             @unique
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  business              Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy             BusinessMembership? @relation("InvitationSender", fields: [invitedByMembershipId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, email])
  @@index([expiresAt])
}

model MerchantApplication {
  id                String                     @id @default(cuid())
  businessId        String
  slug              String
  name              String
  summary           String
  status            MerchantApplicationStatus  @default(NOT_INSTALLED)
  launchUrl         String?
  installedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  business          Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, slug])
  @@index([businessId, status])
}

model PortalSession {
  id           String             @id @default(cuid())
  tokenHash    String             @unique
  membershipId String
  expiresAt    DateTime
  lastSeenAt   DateTime           @default(now())
  createdAt    DateTime           @default(now())
  membership   BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@index([expiresAt])
}

model ApplicationReturnStateNonce {
  id         String   @id @default(cuid())
  nonce      String   @unique @db.Uuid
  expiresAt  DateTime
  consumedAt DateTime @default(now())

  @@index([expiresAt])
}

model PortalCapabilityAccess {
  id             String             @id @default(cuid())
  businessId     String
  userId         String
  membershipId   String
  capabilitySlug String
  createdAt      DateTime           @default(now())
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user           PortalUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership     BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, capabilitySlug])
  @@index([businessId, capabilitySlug])
  @@index([userId])
}

model HQ {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  name        String
  type        HQType
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  memberships HQMembership[]
  assignments HQBusinessAssignment[]
}

model HQBusinessAssignment {
  id         String    @id @default(cuid())
  hqId       String
  businessId String
  assignedAt DateTime  @default(now())
  removedAt  DateTime?
  assignedBy String?
  hq         HQ        @relation(fields: [hqId], references: [id], onDelete: Cascade)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([hqId, businessId])
  @@index([businessId, removedAt])
}

model HQUser {
  id                  String           @id @default(cuid())
  username            String           @unique
  name                String
  passwordHash        String
  mfaSecretCiphertext String?
  mfaEnabledAt        DateTime?
  status              PortalUserStatus @default(ACTIVE)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  memberships         HQMembership[]
}

model HQMembership {
  id            String           @id @default(cuid())
  hqId          String
  userId        String
  role          HQRole           @default(OPERATOR)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  hq            HQ               @relation(fields: [hqId], references: [id], onDelete: Cascade)
  user          HQUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      HQSession[]
  mfaChallenges HQMfaChallenge[]

  @@unique([hqId, userId])
  @@index([userId, isActive])
}

model HQMfaChallenge {
  id           String       @id @default(cuid())
  tokenHash    String       @unique
  membershipId String
  attempts     Int          @default(0)
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  membership   HQMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@index([expiresAt])
}

model HQSession {
  id           String       @id @default(cuid())
  tokenHash    String       @unique
  membershipId String
  expiresAt    DateTime
  lastSeenAt   DateTime     @default(now())
  createdAt    DateTime     @default(now())
  membership   HQMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@index([expiresAt])
}

model HQSupportSession {
  id               String       @id @default(cuid())
  tokenHash        String       @unique
  businessId       String
  originHqId       String
  originHqName     String
  hqUserId         String
  operatorName     String
  operatorUsername String
  accessMode       HQAccessMode
  ticketIssuedAt   DateTime
  expiresAt        DateTime
  auditIdentifier  String
  createdAt        DateTime     @default(now())
  lastSeenAt       DateTime     @default(now())
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, expiresAt])
  @@index([auditIdentifier])
}

model HQAccessAuditEvent {
  id               String              @id @default(cuid())
  auditIdentifier  String
  action           HQAccessAuditAction
  businessId       String
  originHqId       String
  originHqName     String
  hqUserId         String
  operatorName     String
  operatorUsername String
  accessMode       HQAccessMode
  ticketIssuedAt   DateTime
  expiresAt        DateTime
  createdAt        DateTime            @default(now())
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([auditIdentifier, createdAt])
  @@index([businessId, createdAt])
}

model HQMerchantStatusAuditEvent {
  id               String         @id @default(cuid())
  businessId       String
  previousStatus   MerchantStatus
  newStatus        MerchantStatus
  hqId             String
  hqUserId         String
  operatorName     String
  operatorUsername String
  createdAt        DateTime       @default(now())
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([hqId, createdAt])
}

model HQAccessTicketNonce {
  nonce           String   @id
  businessId      String
  auditIdentifier String
  expiresAt       DateTime
  consumedAt      DateTime @default(now())
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([businessId, consumedAt])
}
